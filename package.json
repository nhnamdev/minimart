{
  "name": "minimart",
  "version": "1.0.0",
  "private": true,
  "description": "Giao diện đặt hàng trực tuyến cho Cửa hàng tiện lợi MiniMart",
  "license": "MIT",
  "keywords": [
    "minimart",
    "ecommerce",
    "nextjs",
    "tailwindcss",
    "typescript"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server/index.mjs",
    "server:check": "node --check server/config.mjs && node --check server/db.mjs && node --check server/storage.mjs && node --check server/auth.mjs && node --check server/index.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run server:check && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@base-ui/react": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.6.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
